# ===================================================================
# SMART CAMPUS SUPER APP — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or configure in Render Dashboard
# Never commit active credentials or keys to version control.
# ===================================================================

# Active Spring Profile (local or prod)
SPRING_PROFILES_ACTIVE=local

# Application Port (Render dynamically injects PORT environment variable)
SERVER_PORT=8080

# Database Configuration (Point to 127.0.0.1 for local dev, or secure tunnel address for Render)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_campus_db
DB_USERNAME=campus_app_user
DB_PASSWORD=Campus@Secure2026!

# JWT Security (Must be at least 256-bit base64-encoded or hex string in production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated client URLs)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://smart-campus-super-app.vercel.app

# File Storage Configuration
UPLOAD_DIR=./uploads
